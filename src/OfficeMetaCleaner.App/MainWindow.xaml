<Window x:Class="OfficeMetaCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OfficeMetaCleaner — очистка метаданных Office"
        Height="740" Width="1020" MinHeight="580" MinWidth="840"
        Background="{StaticResource WindowBg}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave">

    <Window.Resources>
        <Style x:Key="DetailsLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   ToolTip="{Binding Detail}"
                                   VerticalAlignment="Center"
                                   Margin="8,0"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextTrimming="CharacterEllipsis"
                                   TextDecorations="Underline"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HintIcon" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Help"/>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Готово">
                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Ошибка">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Пропущен">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Error">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="2,0,2,14">
            <TextBlock Text="OfficeMetaCleaner" Style="{StaticResource TitleText}"/>
            <Grid Margin="0,4,0,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource SubtitleText}" VerticalAlignment="Center"
                           Text="Удаляет метаданные из файлов Microsoft Office, сохраняя файлы рабочими. Перетащите файлы или папки в окно."/>
                <Button x:Name="SettingsButton" Grid.Column="1" Click="SettingsButton_Click"
                        Style="{StaticResource SecondaryButton}"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE713;" FontSize="14"
                        Margin="12,0,0,0" VerticalAlignment="Center" Padding="8,4"
                        ToolTip="Настройки очистки"/>
            </Grid>
            <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Left" VerticalOffset="-8" StaysOpen="False" AllowsTransparency="True">
                <Border Style="{StaticResource Card}" Padding="12">
                    <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                        <CheckBox x:Name="StripImagesCheck" Content="Удалять EXIF изображений" IsChecked="True"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="?" Style="{StaticResource HintIcon}">
                            <TextBlock.ToolTip>
                                <TextBlock x:Name="HintImagesText" MaxWidth="280" TextWrapping="Wrap"
                                           Text="Удаляет скрытые данные фотографий внутри документа: место съёмки, модель камеры, дату. Сами картинки не меняются."/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                        <CheckBox x:Name="RemoveSignaturesCheck" Content="Удалять цифровые подписи"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="?" Style="{StaticResource HintIcon}">
                            <TextBlock.ToolTip>
                                <TextBlock x:Name="HintSignaturesText" MaxWidth="280" TextWrapping="Wrap"
                                           Text="Удаляет встроенные цифровые подписи. Учтите: после любой очистки подписи всё равно становятся недействительными."/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                        <CheckBox x:Name="WaitBusyCheck" Content="Ждать закрытия занятых файлов" IsChecked="True"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="?" Style="{StaticResource HintIcon}">
                            <TextBlock.ToolTip>
                                <TextBlock x:Name="HintWaitText" MaxWidth="280" TextWrapping="Wrap"
                                           Text="Если файл открыт в Word или Excel, программа подождёт, пока вы его закроете, и почистит автоматически. Свободные файлы обрабатываются первыми."/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="PrivacyFlagsCheck" Content="Зачищать сведения о пользователе в Word/PowerPoint" IsChecked="True"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="?" Style="{StaticResource HintIcon}">
                            <TextBlock.ToolTip>
                                <TextBlock x:Name="HintPrivacyText" MaxWidth="280" TextWrapping="Wrap"
                                           Text="Проставляет в файлах Word и PowerPoint отметку «удалять сведения об авторе при сохранении» — Office сам будет стирать ваше имя при каждом сохранении, даже после правок. В Excel такой отметки нет."/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                        <TextBlock x:Name="LanguageLabel" Text="Язык:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="LanguageBox" Margin="8,0,0,0" MinWidth="140"
                                  VerticalAlignment="Center" SelectionChanged="LanguageBox_Changed">
                            <ComboBoxItem Content="Система" Tag="auto"/>
                            <ComboBoxItem Content="Русский" Tag="ru"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
                </Border>
            </Popup>
        </StackPanel>

        <!-- Список файлов -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="FilesGrid" ItemsSource="{Binding Items}"
                          SelectionMode="Extended"
                          MouseDoubleClick="FilesGrid_DoubleClick"
                          AlternatingRowBackground="#FAFBFC">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="FileColumn" Header="Файл" Width="*">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Name"/>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding FilePath}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn x:Name="TypeColumn" Header="Тип" Width="170" Binding="{Binding Container}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn x:Name="StatusColumn" Header="Статус" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"
                                               VerticalAlignment="Center" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="DetailsColumn" Header="Детали" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Detail}"
                                            ToolTip="{Binding Detail}"
                                            Style="{StaticResource DetailsLink}"
                                            VerticalAlignment="Center"
                                            Click="DetailButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="EmptyHint"
                           Text="Перетащите сюда файлы .docx .xlsx .pptx .doc .xls .ppt — или добавьте их кнопками ниже"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="13.5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="520"/>
            </Grid>
        </Border>

        <!-- Настройки -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock x:Name="FilesSectionText" Text="Работа с файлами" Style="{StaticResource SectionTitle}"/>

                <WrapPanel Margin="0,0,0,10">
                    <CheckBox x:Name="InPlaceCheck" Content="Заменять исходные файлы"
                              Checked="InPlace_Changed" Unchecked="InPlace_Changed"/>
                </WrapPanel>

                <StackPanel x:Name="OutputModePanel" Orientation="Horizontal">
                    <RadioButton x:Name="OutputBesideRadio" Content="Результат рядом с исходником"
                                 IsChecked="True" VerticalAlignment="Center"
                                 Checked="OutputMode_Changed"/>
                    <RadioButton x:Name="OutputFolderRadio" Content="В папку:"
                                 Margin="24,0,8,0" VerticalAlignment="Center"
                                 Checked="OutputMode_Changed"/>
                    <TextBox x:Name="OutputFolderBox" Width="380" Height="28"
                             VerticalContentAlignment="Center" IsEnabled="False"
                             Padding="8,0"/>
                    <Button x:Name="BrowseButton" Content="…" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Padding="12,4" IsEnabled="False" Click="Browse_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Прогресс и действия -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="1" Value="0"
                         Foreground="{StaticResource Accent}" Background="#EAECF0" BorderThickness="0"/>
            <TextBlock x:Name="SummaryText" Style="{StaticResource SubtitleText}" Margin="0,6,0,10"
                       Text="Файлы не выбраны"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="AddFilesButton" Content="Добавить файлы" Style="{StaticResource ToolbarButton}" Click="AddFiles_Click"/>
                    <Button x:Name="AddFolderButton" Content="Добавить папку" Style="{StaticResource ToolbarButton}" Margin="6,0,0,0" Click="AddFolder_Click"/>
                    <Button x:Name="RemoveSelectedButton" Content="Убрать выбранные" Style="{StaticResource ToolbarButton}" Margin="6,0,0,0" Click="RemoveSelected_Click"/>
                    <Button x:Name="ClearListButton" Content="Очистить список" Style="{StaticResource ToolbarButton}" Margin="6,0,0,0" Click="ClearList_Click"/>
                    <Button x:Name="ResetMarksButton" Content="Сбросить отметки" Style="{StaticResource ToolbarButton}" Margin="6,0,0,0" Click="ResetMarks_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="OpenResultButton" Content="Открыть результат"
                            Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11.5"
                            Margin="0,0,6,0" IsEnabled="False" Click="OpenResult_Click"/>
                    <Button x:Name="CancelButton" Content="Отмена"
                            Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11.5"
                            Margin="0,0,6,0" IsEnabled="False" Click="Cancel_Click"/>
                    <Button x:Name="CleanButton" Content="Очистить метаданные"
                            Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11.5"
                            Click="Clean_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
