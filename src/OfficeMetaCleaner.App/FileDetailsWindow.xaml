<Window x:Class="OfficeMetaCleaner.App.FileDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали очистки"
        Height="480" Width="640" MinHeight="320" MinWidth="480"
        Background="{StaticResource WindowBg}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="FileNameText" Style="{StaticResource SectionTitle}"
                   FontSize="14" TextTrimming="CharacterEllipsis"/>

        <TextBlock x:Name="SummaryText" Grid.Row="1" Style="{StaticResource SubtitleText}" Margin="0,0,0,12"/>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <ListBox x:Name="DetailsList"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="12.5"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <Button x:Name="CloseButton" Grid.Row="3" Content="Закрыть" Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Right" Margin="0,14,0,0" Padding="16,5"
                IsDefault="True" IsCancel="True" Click="Close_Click"/>
    </Grid>
</Window>
